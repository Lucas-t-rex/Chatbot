# =============================================================================
# Copie este arquivo para ".env" (rodar local) e preencha.
# Em produção (Fly.io) estes valores vão como secrets:
#   fly secrets set SUPABASE_DB_URL="..." API_SECRET="..." --app chatbot-python-lucas
# NUNCA commite o .env de verdade.
# =============================================================================

# --- Banco (Supabase) --------------------------------------------------------
# Supabase > Project Settings > Database > Connection string > "Session pooler"
# Formato: postgresql://postgres.<id-do-projeto>:<SENHA>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# --- Segurança do app --------------------------------------------------------
# Assina o token de login do app. Qualquer texto longo e aleatório.
# Trocar este valor desloga todo mundo do app.
API_SECRET=

# --- WhatsApp (Evolution API) ------------------------------------------------
EVOLUTION_API_URL=https://evolution-api-lucas.fly.dev
EVOLUTION_API_KEY=
# Instância que grava as conversas (padrão: chatbot) e a que só envia relatórios (padrão: relatorio).
# Enquanto a de relatórios não estiver conectada, os relatórios saem pela principal.
EVOLUTION_INSTANCE=chatbot
EVOLUTION_INSTANCE_RELATORIO=relatorio
BOT_WEBHOOK_URL=https://chatbot-python-lucas.fly.dev/webhook

# --- IA (Gemini) -------------------------------------------------------------
# Obrigatória para o modo "chat"/"ambos" e para transcrever áudio no analista.
GEMINI_API_KEY=

# --- Modo inicial ------------------------------------------------------------
# Só vale na primeira subida (depois o modo fica salvo no banco e é trocado
# pelo app). Valores: analista | chat | ambos
MODO_OPERACAO=analista

# Transcrever áudios no modo analista (gasta um pouco de Gemini): true | false
AUDITOR_TRANSCREVER_AUDIO=true

# --- Analista com IA (le cada conversa e da notas) -----------------------------
# Fica DESLIGADO enquanto a chave estiver vazia.
# Provedor: gemini (AI Studio) | vertex (Vertex AI, usa creditos do Google Cloud) | anthropic | openai
ANALISTA_IA_PROVEDOR=gemini
ANALISTA_IA_MODELO=gemini-3-flash-preview
ANALISTA_IA_API_KEY=
# curso = script da academia (padrao, app/prompts/metodo_vendas_curso.md) | geral = boas praticas de reserva
METODO_FONTE=curso
